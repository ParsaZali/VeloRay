[Unit]
Description=Apply verified VeloRay server changes
Wants=network-online.target
After=network-online.target postgresql.service
ConditionPathExists=/etc/veloray/veloray.env
ConditionPathExists=/opt/veloray/current/deploy/systemd/veloray-host-control.service
[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/veloray/veloray.env
ExecStart=/usr/local/bin/veloray sync-host-control
TimeoutStartSec=90min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
