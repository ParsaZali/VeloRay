[Unit]
Description=VeloRay node agent
After=network-online.target xray.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/veloray-node/agent.env
Environment=XRAY_LOCATION_ASSET=/usr/local/share/xray
ExecStart=/usr/local/bin/veloray-agent
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
ReadWritePaths=/usr/local/etc/xray /usr/local/share/xray /var/lib/veloray-agent /var/log/xray /var/lib/veloray-cores

[Install]
WantedBy=multi-user.target
