# Local development only. Generate distinct keys with: openssl rand -hex 32
VELORAY_SECRET_KEY=
VELORAY_FIELD_KEY=
VELORAY_LISTEN=127.0.0.1:8610
VELORAY_PUBLIC_URL=http://127.0.0.1:5173
VELORAY_COOKIE_SECURE=false
VELORAY_FRONTEND_DIR=frontend/dist
VELORAY_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8610
VELORAY_SESSION_AGE=43200
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=veloray
POSTGRES_USER=veloray
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

# Operator-owned custom HTML templates and their assets.
VELORAY_TEMPLATE_ROOT=/etc/veloray/templates
