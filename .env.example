# Local development only. Generate distinct keys with: openssl rand -hex 32
VELORAY_SECRET_KEY=
VELORAY_FIELD_KEY=
VELORAY_LISTEN=127.0.0.1:8610
VELORAY_PUBLIC_URL=http://127.0.0.1:5173
VELORAY_COOKIE_SECURE=false
VELORAY_FRONTEND_DIR=frontend/dist
VELORAY_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8610
VELORAY_SESSION_AGE=43200
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=veloray
POSTGRES_USER=veloray
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

# Operator-owned custom HTML templates and their assets.
VELORAY_TEMPLATE_ROOT=/etc/veloray/templates

# Only these proxy CIDRs may supply X-Forwarded-For. Empty value disables trust.
VELORAY_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Optional production-only SSO; requires HTTPS and secure cookies.
# GitHub callback: https://your-domain/api/auth/github/callback
VELORAY_GITHUB_CLIENT_ID=
VELORAY_GITHUB_CLIENT_SECRET=
# Alternatively mount VELORAY_GITHUB_CLIENT_SECRET_FILE (do not set both).
# Telegram uses standard OIDC: issuer https://oauth.telegram.org;
# use the separate Client ID/Secret from BotFather's Login settings.
VELORAY_OIDC_ISSUER=
VELORAY_OIDC_CLIENT_ID=
VELORAY_OIDC_CLIENT_SECRET=

# Optional directory sign-in. Configure HTTPS and secure cookies first.
# Bind full DNs explicitly in each administrator account; no automatic provisioning.
VELORAY_LDAP_URL=
VELORAY_LDAP_CA_FILE=
