#!/usr/bin/env bash
set -Eeuo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
ENV_FILE="${VELORAY_ENV_FILE:-/etc/veloray/veloray.env}"
command="${1:-menu}"; shift || true
if [[ "$command" == help || "$command" == --help ]];then
 cat <<'HELP'
VeloRay 1.0 · Server management
  veloray                         Interactive menu
  veloray status | doctor | url
  veloray start | stop | restart
  veloray logs [web|agent|xray|singbox|subscriptions|install]
  veloray audit [LIMIT]
  veloray reset [USERNAME]
  veloray admin-list
  veloray domain HOST | port PORT | ssl EMAIL
  veloray backup [FILE] | restore FILE
  veloray backup-schedule daily|off
  veloray repair | update [DIRECTORY] | uninstall [--purge]
  veloray auto-update enable|disable|status|check|run
  veloray ports | inbounds | inbound-port ID PORT
  veloray language en|fa
HELP
 exit 0
fi
[[ -f "$ENV_FILE" ]] || { echo 'VeloRay is not installed. Run install.sh first.' >&2; exit 1; }
set -a
source "$ENV_FILE"
set +a
export VELORAY_LANGUAGE="${VELORAY_LANGUAGE:-en}"
source /opt/veloray/current/scripts/common.sh
source /opt/veloray/current/scripts/auto-update.sh
vr_log_init
WEB=veloray-web.service
AGENT=veloray-agent.service
SUBSCRIPTIONS=veloray-subscriptions.service
ENDPOINT_TIMER=veloray-subscription-endpoint.timer
subscription_wanted() {
 [[ -f /etc/systemd/system/veloray-subscriptions.service ]] && { systemctl is-enabled --quiet "$SUBSCRIPTIONS" 2>/dev/null || systemctl is-active --quiet "$SUBSCRIPTIONS" 2>/dev/null; }
}
trap 'vr_error "$LINENO" "$?"' ERR
VR_STEP="$(vr_text 'Server management' 'مدیریت سرور')"
summary() {
 printf 'VeloRay 1.0\n\n'
 vr_say "Panel: $VELORAY_PUBLIC_URL" "آدرس پنل: $VELORAY_PUBLIC_URL"
 local unit state label
 local units=("$WEB" "$AGENT" xray.service sing-box.service)
 [[ ! -f /etc/systemd/system/veloray-subscriptions.service ]] || units+=("$SUBSCRIPTIONS")
 for unit in "${units[@]}";do
  state="$(systemctl is-active "$unit" 2>/dev/null)"||true
  label="${state:-unknown}"
  if [[ "${VELORAY_LANGUAGE:-en}" == fa ]];then case "$state" in active) label=فعال;;inactive) label=خاموش;;failed) label=خطا;;activating) label=درحال‌راه‌اندازی;;esac;fi
  printf '  %-22s ' "${unit%.service}"
  case "$state" in active) vr_color 32 "$label";;failed) vr_color 31 "$label";;*) vr_color 33 "$label";;esac;printf '\n'
 done
}
doctor() {
 local unit body failed=0
 local units=("$WEB" "$AGENT" xray.service sing-box.service postgresql.service nginx.service)
 if subscription_wanted;then units+=("$SUBSCRIPTIONS");fi
 for unit in "${units[@]}";do
  if systemctl is-active --quiet "$unit";then vr_success "$unit" "$unit";else vr_failure "$unit" "$unit";failed=1;fi
 done
 if vr_run nginx -t;then vr_success 'HTTPS configuration' 'پیکربندی HTTPS';else vr_failure 'HTTPS configuration' 'پیکربندی HTTPS';failed=1;fi
 if body="$(curl -fsS --max-time 5 http://127.0.0.1:8610/api/health 2>>"$VELORAY_INSTALL_LOG")" && jq -e '.status=="ok"' <<<"$body" >/dev/null 2>&1;then vr_success 'Panel and database' 'پنل و پایگاه داده';else vr_failure 'Panel or database is unavailable' 'پنل یا پایگاه داده در دسترس نیست';failed=1;fi
 if body="$(curl -fsS --max-time 10 -H "Authorization: Bearer $VELORAY_LOCAL_NODE_TOKEN" http://127.0.0.1:9191/health 2>>"$VELORAY_INSTALL_LOG")" && jq -e '.status=="ok" and .xray.installed==true and .xray.running==true' <<<"$body" >/dev/null 2>&1;then vr_success 'Agent and Xray runtime' 'نود و سرویس Xray';else vr_failure 'Xray is stopped or the agent is unavailable; run veloray repair' 'سرویس Xray خاموش است یا نود پاسخ نمی‌دهد؛ دستور veloray repair را اجرا کنید';failed=1;fi
 if body="$(curl -fsS --max-time 15 -H "Authorization: Bearer $VELORAY_LOCAL_NODE_TOKEN" http://127.0.0.1:9191/xray/stats 2>>"$VELORAY_INSTALL_LOG")" && jq -e '.accounting=="durable-v1" and (.ledger_id|type=="string" and length>0)' <<<"$body" >/dev/null 2>&1;then vr_success 'Persistent traffic accounting' 'ثبت پایدار مصرف ترافیک';else vr_failure 'Traffic accounting API is unavailable' 'رابط ثبت ترافیک در دسترس نیست';failed=1;fi
 if vr_ports_check;then vr_success 'VPN listener ports' 'پورت‌های اتصال VPN';else failed=1;fi
 if ((failed));then vr_diagnostics;vr_say "Inspect: $VELORAY_INSTALL_LOG" "گزارش عیب‌یابی: $VELORAY_INSTALL_LOG";return 1;fi
 vr_say 'All checks passed.' 'همهٔ بررسی‌ها موفق بود.'
}
menu() {
 local selection value
 while true;do
  [[ ! -t 1 ]]||printf '\033[2J\033[H'
  summary
  cat <<'MENU'

  SERVICES                         ACCESS
   1  Service status                7  Reset administrator password
   2  Panel address                 8  Change domain or IP
   3  Restart services              9  Change panel port
   4  Start services               10  HTTPS certificate
   5  Stop services
   6  View logs

  MAINTENANCE                      NETWORK
  11  Create backup                19  Inspect VPN ports
  12  Restore backup               20  Change inbound port
  13  Daily backups                21  List inbounds
  14  Health check
  15  Recover Xray
  16  Update VeloRay
  17  Uninstall VeloRay
  18  Automatic updates

   0  Exit
MENU
  [[ -t 0 ]]||return 0
  read -rp "$(vr_text 'Select [0–21]: ' 'انتخاب [۰ تا ۲۱]: ')" selection||return 0
  local -a operation=()
  case "$selection" in
   0) return 0;;1) operation=(status);;2) operation=(url);;3) operation=(restart);;4) operation=(start);;5) operation=(stop);;
   6) read -rp "$(vr_text 'Log [web/agent/xray/install]: ' 'گزارش [web/agent/xray/install]: ')" value;operation=(logs "${value:-web}");;
   7) read -rp "$(vr_text 'Username [Enter = detect administrator]: ' 'نام کاربری [Enter = تشخیص مدیر]: ')" value;operation=(reset);[[ -z "$value" ]]||operation+=("$value");;
   8) read -rp "$(vr_text 'New domain or IP: ' 'دامنه یا آی‌پی جدید: ')" value;operation=(domain "$value");;
   9) read -rp "$(vr_text 'New port: ' 'پورت جدید: ')" value;operation=(port "$value");;
   10) read -rp "$(vr_text 'Certificate email: ' 'ایمیل گواهی: ')" value;operation=(ssl "$value");;
   11) operation=(backup);;
   12) read -rp "$(vr_text 'Backup path: ' 'مسیر فایل پشتیبان: ')" value;operation=(restore "$value");;
   13) read -rp "$(vr_text 'Daily backups [daily/off]: ' 'پشتیبان روزانه [daily/off]: ')" value;operation=(backup-schedule "$value");;
   14) operation=(doctor);;15) operation=(repair);;16) operation=(update);;17) operation=(uninstall);;
   18) read -rp "$(vr_text 'Auto-update [enable/disable/status/check/run]: ' 'به‌روزرسانی خودکار [enable/disable/status/check/run]: ')" value;operation=(auto-update "${value:-status}");;
   19) operation=(ports);;
   20) veloray host-inbounds|jq -r '.[]|"ID=\(.id)  \(.name)  :\(.port)"';read -rp "$(vr_text 'Inbound ID: ' 'شناسه اتصال: ')" value;read -rp "$(vr_text 'New VPN port: ' 'پورت جدید VPN: ')" port;operation=(inbound-port "$value" "$port");;
   21) operation=(inbounds);;
   *) vr_say 'Choose a listed number.' 'یکی از شماره‌های منو را وارد کنید.';continue;;
  esac
  "$0" "${operation[@]}"||true
  [[ "$selection" != 17 || -x "$0" ]]||return 0
  set -a;source "$ENV_FILE";set +a;export VELORAY_LANGUAGE="${VELORAY_LANGUAGE:-en}"
  read -rp "$(vr_text 'Press Enter to return…' 'برای بازگشت Enter بزنید…')" value||return 0
 done
}
case "$command" in
 menu) menu;;
 status) summary;;
 url) printf '%s\n' "$VELORAY_PUBLIC_URL";;
 ports) status=0;vr_ports_check||status=$?;if [[ -n "${VR_PORTS_REPORT:-}" ]];then jq -r '.ports[]|"\(.network) \(.listen):\(.port)  \(.tag)  \(.state)  \(.owner // "")"' <<<"$VR_PORTS_REPORT";fi;exit "$status";;
 audit) [[ $# -le 1 ]]||{ echo 'Usage: sudo veloray audit [LIMIT]' >&2;exit 2; };veloray host-audit "${1:-100}";;
 inbounds) veloray host-inbounds|jq -r '.[]|"ID=\(.id)  \(.name)  \(.listen):\(.port)  \(.protocol)  enabled=\(.enabled)"';;
 inbound-port) [[ $# -eq 2 ]]||{ echo 'Usage: sudo veloray inbound-port ID PORT' >&2;exit 2; };veloray host-inbound-port "$1" "$2";vr_say 'Inbound port deployed. Refresh client subscriptions to receive the new port.' 'پورت اتصال اعمال شد؛ اشتراک کاربران را برای دریافت پورت جدید به‌روزرسانی کنید.';;
 doctor) doctor;;
 start|stop|restart)
 subscription_units=()
 if subscription_wanted;then subscription_units+=("$SUBSCRIPTIONS");fi
 vr_step "${command^} services" 'مدیریت سرویس‌های پنل و Xray'
 if [[ -f /etc/systemd/system/$ENDPOINT_TIMER ]];then vr_run systemctl stop "$ENDPOINT_TIMER" veloray-subscription-endpoint.service;fi
 if [[ "$command" == stop ]];then vr_run systemctl stop "$WEB" "$AGENT" xray.service sing-box.service "${subscription_units[@]}";else
  vr_ports_check
  vr_run systemctl reset-failed xray.service
  vr_run systemctl "$command" xray.service sing-box.service "$AGENT" "$WEB" "${subscription_units[@]}"
  vr_wait http://127.0.0.1:8610/api/health
  vr_wait http://127.0.0.1:9191/health "$VELORAY_LOCAL_NODE_TOKEN"
  if [[ -f /etc/systemd/system/$ENDPOINT_TIMER ]];then vr_run systemctl start "$ENDPOINT_TIMER";fi
  doctor
 fi
 summary;;
 logs) unit="$WEB";case "${1:-web}" in agent) unit="$AGENT";;subscriptions) unit="$SUBSCRIPTIONS";;singbox) unit=sing-box.service;;xray) unit=xray.service;;web) ;;
 install) latest="$(find /var/log/veloray -maxdepth 1 -name 'install-*.log' -type f | sort | tail -1)";[[ -n "$latest" ]]||{ vr_say 'No installation log found.' 'گزارش نصب موجود نیست.';exit 1; };exec tail -n 100 "$latest";;
 *) vr_say 'Use web, agent, xray, singbox, subscriptions or install.' 'گزینهٔ web، agent، xray، singbox، subscriptions یا install را انتخاب کنید.';exit 2;;esac;exec journalctl -u "$unit" -n 100 -f;;
 language) [[ "${1:-}" == en || "${1:-}" == fa ]]||exit 2;veloray set-env VELORAY_LANGUAGE "$1";vr_say 'Language saved.' 'زبان ذخیره شد.';;
 backup) dir=/var/lib/veloray/backups;install -d -m 0700 "$dir"; file="${1:-$dir/veloray-$(date -u +%Y%m%dT%H%M%S%NZ).tar.gz}"; veloray backup "$file";echo "$file"; ;;
 restore) [[ $# -eq 1 ]] || { echo 'Usage: velorayctl restore FILE.tar.gz' >&2;exit 2; }
 vr_run veloray backup-verify "$1"
 vr_say 'Restore replaces current panel data and configuration. A recovery backup is created first.' 'بازیابی، اطلاعات و تنظیمات فعلی را جایگزین می‌کند؛ ابتدا پشتیبان بازیابی گرفته می‌شود.'
 read -rp "$(vr_text 'Type RESTORE to continue: ' 'برای ادامه RESTORE را وارد کنید: ')" confirmation
 [[ "$confirmation" == RESTORE ]]||{ vr_say 'Cancelled.' 'لغو شد.';exit 0; }
 # Always create a recovery point before replacing data and secrets.
 "$0" backup
 systemctl stop "$ENDPOINT_TIMER" veloray-subscription-endpoint.service 2>/dev/null||true
 subscriptions_active=false
 if systemctl is-active --quiet "$SUBSCRIPTIONS";then subscriptions_active=true;systemctl stop "$SUBSCRIPTIONS";fi
 systemctl stop "$WEB" "$AGENT" xray.service sing-box.service
 trap 'echo "Restore stopped. Inspect the error and recovery backup before restarting services." >&2' ERR
 veloray restore-data "$1"
 chown root:veloray "$ENV_FILE";chmod 0640 "$ENV_FILE"
 chown root:veloray "$(dirname "$ENV_FILE")";chmod 0750 "$(dirname "$ENV_FILE")"
 # Discard old application keys before loading the restored environment.
 while IFS='=' read -r key _;do [[ "$key" =~ ^(VELORAY_[A-Z0-9_]+|DATABASE_URL)$ ]]&&unset "$key"||true;done < "$ENV_FILE"
 set -a;source "$ENV_FILE";set +a;export VELORAY_LANGUAGE="${VELORAY_LANGUAGE:-en}"
 if [[ -d /usr/local/etc/xray ]];then
  find /usr/local/etc/xray -type d -exec chmod 0755 {} +
  find /usr/local/etc/xray -type f -exec chown root:nogroup {} + -exec chmod 0640 {} +
 fi
 # Recreate ACME live links from the restored archive files if present.
 if [[ -d /etc/letsencrypt/archive ]]; then
  for d in /etc/letsencrypt/archive/*;do [[ -d "$d" ]]||continue;live="/etc/letsencrypt/live/$(basename "$d")";mkdir -p "$live";for part in cert chain fullchain privkey;do last="$(find "$d" -maxdepth 1 -name "${part}[0-9]*.pem" | sort -V | tail -1)";[[ -n "$last" ]]&&ln -sfn "$last" "$live/$part.pem";done;done
 fi
 systemctl daemon-reload
 if $subscriptions_active;then systemctl start "$SUBSCRIPTIONS";fi
 veloray render-nginx
 systemctl start xray.service sing-box.service "$AGENT" "$WEB"
 if [[ -f /etc/systemd/system/$ENDPOINT_TIMER ]];then systemctl start "$ENDPOINT_TIMER";fi
 "$0" doctor
 ;;
 reset|admin-reset)
 [[ $# -le 1 ]]||{ echo 'Usage: veloray reset [USERNAME]' >&2;exit 2; }
 if administrator="$(veloray admin-username "$@")";then
  export VELORAY_ADMIN_USERNAME="$administrator"
 else exit 1;fi
 vr_say "Administrator: $administrator" "حساب مدیر: $administrator"
 if [[ -z "${VELORAY_ADMIN_PASSWORD:-}" ]];then
  read -rsp "$(vr_text 'New password [Enter = random]: ' 'رمز جدید [Enter = تصادفی]: ')" VELORAY_ADMIN_PASSWORD||true;printf '\n'
  generated_password=false
  if [[ -z "$VELORAY_ADMIN_PASSWORD" ]];then
   VELORAY_ADMIN_PASSWORD="$(openssl rand -hex 16)";generated_password=true
  else
   read -rsp "$(vr_text 'Confirm password: ' 'تکرار رمز جدید: ')" confirmation;printf '\n'
   [[ "$VELORAY_ADMIN_PASSWORD" == "$confirmation" ]]||{ vr_failure 'Passwords do not match.' 'رمزها یکسان نیستند.' >&2;exit 2; }
  fi
 fi
 export VELORAY_ADMIN_PASSWORD
 if reset_output="$(veloray reset-password 2>&1)";then vr_say "Password changed for $VELORAY_ADMIN_USERNAME. Existing sessions were revoked." "رمز $VELORAY_ADMIN_USERNAME تغییر کرد و نشست‌های قبلی بسته شد.";else unset VELORAY_ADMIN_PASSWORD;printf '%s\n' "$reset_output" | tee -a "$VELORAY_INSTALL_LOG" >&2;exit 1;fi
 [[ "${generated_password:-false}" != true ]]||printf '  Password: %s\n' "$VELORAY_ADMIN_PASSWORD"
 unset VELORAY_ADMIN_PASSWORD confirmation;;
 domain|port) [[ $# -eq 1 ]]||exit 2
 old_origin="$VELORAY_PUBLIC_URL";old_host="$VELORAY_PUBLIC_HOST";old_port="$VELORAY_PANEL_PORT"
 if [[ "$command" == domain ]];then [[ "$1" =~ ^[a-zA-Z0-9.-]+$ ]]||exit 2;host="$1";port="$VELORAY_PANEL_PORT";else [[ "$1" =~ ^[0-9]+$ ]]&&(( $1>0&&$1<65536 ))||exit 2;host="$VELORAY_PUBLIC_HOST";port="$1";fi
 # Reject reserved/listening inbound ports via the Go command before changing host files.
 veloray configure-origin "$host" "$port"
 set -a;source "$ENV_FILE";set +a;export VELORAY_LANGUAGE="${VELORAY_LANGUAGE:-en}"
 if ! veloray render-nginx;then veloray set-env VELORAY_PUBLIC_URL "$old_origin";veloray set-env VELORAY_PUBLIC_HOST "$old_host";veloray set-env VELORAY_PANEL_PORT "$old_port";echo 'Nginx rejected the change. Environment origin restored.' >&2;exit 1;fi
 systemctl restart "$WEB"
 if subscription_wanted;then systemctl restart "$SUBSCRIPTIONS";vr_wait http://127.0.0.1:8611/api/health;fi
 ;;
 ssl) [[ $# -eq 1 && -n "${VELORAY_PUBLIC_HOST:-}" ]]||exit 2
 [[ "$VELORAY_PUBLIC_HOST" =~ ^[A-Za-z0-9.-]+$ && ! "$VELORAY_PUBLIC_HOST" =~ ^[0-9.]+$ && "$VELORAY_PANEL_PORT" != 80 ]]||{ vr_say 'Configure a public domain and use an HTTPS port other than 80 first.' 'ابتدا یک دامنهٔ عمومی و پورت HTTPS غیر از ۸۰ تنظیم کنید.' >&2;exit 2; }
 vr_step 'Issue HTTPS certificate' 'صدور گواهی HTTPS'
 vr_run veloray render-nginx
 vr_run certbot certonly --webroot --webroot-path /var/lib/veloray-acme --preferred-challenges http --agree-tos --non-interactive --email "$1" -d "$VELORAY_PUBLIC_HOST"
 vr_run veloray render-nginx
 vr_say 'Trusted HTTPS certificate installed. Automatic renewal is enabled.' 'گواهی معتبر HTTPS نصب شد؛ تمدید خودکار فعال است.';;
 repair)
 vr_step 'Validate and recover Xray' 'بررسی و بازیابی سرویس Xray'
 vr_xray_prepare
 if ! vr_xray_check;then vr_say 'Xray config was rejected. Check certificate access and veloray logs xray.' 'پیکربندی Xray رد شد؛ دسترسی گواهی‌ها و veloray logs xray را بررسی کنید.' >&2;vr_error "$LINENO" 1;fi
 vr_run systemctl restart "$AGENT"
 vr_resolve_ports
 vr_run systemctl reset-failed xray.service
 vr_run systemctl restart xray.service sing-box.service "$AGENT"
 vr_wait http://127.0.0.1:9191/health "$VELORAY_LOCAL_NODE_TOKEN"
 doctor;;
 backup-schedule)
 case "${1:-}" in
 daily)
  cat >/etc/systemd/system/veloray-backup.service <<'SERVICE'
[Unit]
Description=VeloRay recovery backup
After=postgresql.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/velorayctl backup
UMask=0077
Nice=10
SERVICE
  cat >/etc/systemd/system/veloray-backup.timer <<'TIMER'
[Unit]
Description=Daily VeloRay recovery backup
[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=15m
Persistent=true
[Install]
WantedBy=timers.target
TIMER
  vr_run systemctl daemon-reload
  vr_run systemctl enable --now veloray-backup.timer
  vr_say 'Daily backup scheduled around 03:00 server time. Files are kept in /var/lib/veloray/backups.' 'پشتیبان روزانه حدود ساعت ۰۳:۰۰ سرور فعال شد؛ فایل‌ها در /var/lib/veloray/backups ذخیره می‌شوند.';;
 off) vr_run systemctl disable --now veloray-backup.timer;vr_say 'Daily backups disabled. Existing backups are kept.' 'پشتیبان روزانه غیرفعال شد؛ فایل‌های قبلی حفظ می‌شوند.';;
 *) echo 'Usage: veloray backup-schedule daily|off' >&2;exit 2;;esac;;
 update)
 if [[ $# -gt 0 ]];then [[ $# -eq 1 && -f "$1/install.sh" ]]||exit 2;exec bash "$1/install.sh" install --lang "${VELORAY_LANGUAGE:-en}";fi
 vr_autoupdate run;;
 auto-update) vr_autoupdate "${1:-status}";;
 uninstall)
  [[ $# -eq 0 || ( $# -eq 1 && "$1" == --purge ) ]]||{ echo 'Usage: veloray uninstall [--purge]' >&2;exit 2; }
  purge=false;confirmation_word=REMOVE
  if [[ "${1:-}" == --purge ]];then
   purge=true;confirmation_word=PURGE
   [[ -z "${DATABASE_URL:-}" && "${POSTGRES_HOST:-127.0.0.1}" =~ ^(127\.0\.0\.1|localhost)$ && "${POSTGRES_PORT:-5432}" == 5432 && "${POSTGRES_USER:-veloray}" == veloray && "${POSTGRES_DB:-veloray}" == veloray ]]||{ vr_failure 'Automatic purge supports only the installer-managed local veloray database. Custom databases require manual removal.' 'حذف کامل خودکار فقط برای دیتابیس محلی پیش‌فرض veloray مجاز است؛ دیتابیس سفارشی باید دستی بررسی شود.' >&2;exit 2; }
   vr_warn 'Delete VeloRay accounts, VPN configurations, keys and the local veloray database. A private recovery backup is required and kept.' 'حساب‌ها، کانفیگ‌های VPN، کلیدها و دیتابیس محلی veloray پاک می‌شوند. ابتدا بکاپ خصوصی ساخته و حفظ می‌شود.'
  else
   vr_say 'Stop/remove program services. Existing users, VPN configurations, keys and backups are kept for reinstall.' 'سرویس‌های برنامه متوقف و حذف می‌شوند؛ کاربران، کانفیگ‌های VPN، کلیدها و بکاپ‌ها برای نصب مجدد باقی می‌مانند.'
   vr_say 'For a clean installation instead, cancel and run: sudo veloray uninstall --purge' 'برای نصب از صفر، لغو کنید و این دستور را اجرا کنید: sudo veloray uninstall --purge'
  fi
  read -rp "$(vr_text "Type $confirmation_word to continue: " "برای ادامه $confirmation_word را وارد کنید: ")" confirmation
  [[ "$confirmation" == "$confirmation_word" ]]||{ vr_say 'Cancelled.' 'لغو شد.';exit 0; }
  vr_install_lock
  if $purge;then
   install -d -m 0700 /var/lib/veloray/backups
   recovery_backup="/var/lib/veloray/backups/pre-purge-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
   vr_run veloray backup "$recovery_backup"
   chmod 0600 "$recovery_backup"
   vr_say "Recovery backup: $recovery_backup" "بکاپ بازیابی: $recovery_backup"
  fi
  removal_units=(veloray-subscription-endpoint.timer veloray-reconcile.timer veloray-backup.timer veloray-auto-update.timer veloray-subscription-endpoint.service veloray-reconcile.service veloray-backup.service veloray-auto-update.service veloray-web.service veloray-agent.service veloray-subscriptions.service xray.service sing-box.service)
  for unit in "${removal_units[@]}";do
   systemctl stop "$unit" 2>/dev/null||true
   state="$(systemctl is-active "$unit" 2>/dev/null)"||true
   case "$state" in inactive|failed|unknown) ;;*) vr_failure "Could not confirm $unit is stopped. Files and data were kept." "توقف $unit تأیید نشد؛ فایل‌ها و داده‌ها حفظ شدند." >&2;exit 1;;esac
   systemctl disable --now "$unit" 2>/dev/null||true
  done
  if $purge;then
   vr_run runuser -u postgres -- dropdb -h /var/run/postgresql -p 5432 -U postgres --if-exists -- veloray
   vr_run runuser -u postgres -- dropuser -h /var/run/postgresql -p 5432 -U postgres --if-exists -- veloray
   for core in xray sing-box;do
    slot=xray;[[ "$core" != sing-box ]]||slot=singbox
    if [[ -L "/usr/local/bin/$core" && "$(readlink "/usr/local/bin/$core")" == "/var/lib/veloray-cores/$slot/current" ]];then rm -f "/usr/local/bin/$core";fi
   done
   rm -rf -- /etc/veloray /etc/veloray-node /var/lib/veloray-agent /var/lib/veloray-cores /usr/local/etc/xray /usr/local/etc/sing-box
   find /var/lib/veloray -mindepth 1 -maxdepth 1 ! -name '*backup*' -exec rm -rf -- {} +
  fi
  rm -f /etc/systemd/system/veloray-subscription-endpoint.{service,timer} /etc/systemd/system/{veloray-web,veloray-agent,veloray-subscriptions,veloray-reconcile,xray,sing-box}.service /etc/systemd/system/veloray-reconcile.timer /etc/systemd/system/veloray-backup.{service,timer} /etc/systemd/system/veloray-auto-update.{service,timer}
  rm -f /etc/nginx/sites-enabled/veloray /etc/nginx/sites-available/veloray /etc/letsencrypt/renewal-hooks/deploy/veloray-nginx
  systemctl daemon-reload
  if vr_run nginx -t;then vr_run systemctl reload nginx||true;fi
  rm -rf -- /opt/veloray
  rm -f /usr/local/bin/veloray /usr/local/bin/veloray-agent /usr/local/bin/velorayctl
  if $purge;then
   vr_say "VeloRay data removed. Recovery backup: $recovery_backup" "داده‌های VeloRay پاک شدند. بکاپ بازیابی: $recovery_backup"
  else
   vr_say 'VeloRay removed. Existing users and VPN configurations will return on reinstall.' 'VeloRay حذف شد؛ کاربران و کانفیگ‌های قبلی با نصب مجدد برمی‌گردند.'
  fi
 ;;
 node) echo 'Extract the release on the remote server and run: sudo bash deploy/node/install.sh'; ;;
 *) echo 'Unknown command. Run velorayctl help.' >&2;exit 2; ;;
esac
